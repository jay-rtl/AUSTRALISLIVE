---
import { siteConfig } from '../config/site';
import { contact } from '../data/contact';
import { legalNavigation, primaryNavigation } from '../data/navigation';
import { socials } from '../data/socials';
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-brand">
    <img src={withBase(siteConfig.logoPath)} alt="" width="1254" height="1254" loading="lazy" />
    <p>{siteConfig.tagline}</p>
  </div>

  <div class="footer-column">
    <p class="eyebrow">Explore</p>
    <ul>
      {primaryNavigation.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
    </ul>
  </div>

  <div class="footer-column">
    <p class="eyebrow">Stay connected</p>
    {contact.email && <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>}
    <p><a href={withBase('/events/')}>Shows & tickets ↗</a></p>
    <p><a href={withBase('/contact/')}>Ticket enquiries ↗</a></p>
    {socials.length > 0 && <ul>{socials.map((social) => <li><a href={social.url}>{social.label}</a></li>)}</ul>}
  </div>

  <div class="footer-meta">
    <p>© {year} AUSTRALIS LIVE. All rights reserved.</p>
    {legalNavigation.length > 0 && <nav aria-label="Legal">
      {legalNavigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>}
  </div>
</footer>
