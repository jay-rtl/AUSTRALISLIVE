---
import { withBase } from '../utils/paths';
import '../styles/arrow-link.css';

interface Props {
  href: string;
  variant?: 'filled' | 'outline' | 'text';
  label: string;
}

const { href, variant = 'text', label } = Astro.props;
---

<a class:list={['arrow-link', `arrow-link--${variant}`]} href={withBase(href)}>
  <span>{label}</span>
  <svg width="32" height="16" viewBox="0 0 32 16" fill="none" stroke="currentColor" aria-hidden="true">
    <path d="M1 8h27M21 1l7 7-7 7" />
  </svg>
</a>
