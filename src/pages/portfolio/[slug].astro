---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ShowFeature from '../../components/ShowFeature.astro';
import { previousShow } from '../../data/shows';
export function getStaticPaths() { return [{ params: { slug: previousShow.id } }]; }
---
<BaseLayout title="Nurse Even | Australis Live" description={previousShow.description} image={previousShow.image}>
  <PageHero eyebrow="Previous show" title="This is BULLSHIFT." intro="Nurse Even - Australia Tour 2026." />
  <div class="show-page"><ShowFeature show={previousShow} past /></div>
</BaseLayout>
