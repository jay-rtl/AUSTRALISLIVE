---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ShowFeature from '../components/ShowFeature.astro';
import { nextShow, previousShow } from '../data/shows';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig, homeCopy } from '../config/site';
import { services } from '../data/services';
import { withBase } from '../utils/paths';
import '../styles/home.css';

const isDev = import.meta.env.DEV;
const media = {
  hero: withBase('/images/atmosphere/hero-stage.webp'),
  material: withBase('/images/atmosphere/material-study.webp'),
};
---

<BaseLayout
  title={siteConfig.defaultTitle}
  description={siteConfig.defaultDescription}
  image="/images/atmosphere/hero-stage.webp"
>
  <Fragment slot="head">
    <link rel="preload" href={withBase(siteConfig.logoPath)} as="image" type="image/png" />
    <link rel="preload" href={media.hero} as="image" type="image/webp" fetchpriority="high" />
    <script is:inline define:vars={{ isDev }}>
      try {
        if (isDev && new URLSearchParams(location.search).get('replay-intro') === '1') {
          sessionStorage.removeItem('al-intro-seen');
        }
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const seen = sessionStorage.getItem('al-intro-seen');
        if (!reduced && !seen) {
          document.documentElement.classList.add('al-intro-pending');
          window.__alIntroFallback = window.setTimeout(() => {
            document.documentElement.classList.remove('al-intro-pending');
          }, 4500);
        }
      } catch (error) {
        document.documentElement.classList.remove('al-intro-pending');
      }
    </script>
  </Fragment>

  <div class="cinematic-intro" data-cinematic-intro aria-hidden="true">
    <div class="cinematic-intro__mark">
      <span class="intro-accent"></span>
      <img src={withBase(siteConfig.logoPath)} alt="" width="1254" height="1254" fetchpriority="high" decoding="async" />
    </div>

  </div>

  <div class="home-page" data-home-page>
    <section class="cinematic-hero" aria-labelledby="hero-title">
      <div class="cinematic-hero__media" data-hero-media>
        <img
          src={media.hero}
          alt=""
          width="1536"
          height="1024"
          fetchpriority="high"
          decoding="async"
        />
        <div class="cinematic-hero__veil"></div>
      </div>

      <div class="cinematic-hero__copy">
        <p class="eyebrow hero-eyebrow">{homeCopy.eyebrow}</p>
        <h1 id="hero-title" class="hero-title">
          {homeCopy.headline.map((line) => <span><span>{line}</span></span>)}
        </h1>
        <p class="hero-summary">
          {homeCopy.summary}
        </p>
        <div class="hero-actions">
          <ArrowLink href="/events/" label={homeCopy.workCta} variant="filled" />
          <ArrowLink href="/events/#lakas-tama" label={homeCopy.inquiryCta} variant="text" />
        </div>
      </div>

      <div class="hero-rail" aria-hidden="true">
        <span>AL</span>
        <span class="hero-rail__line"></span>
        <span>LIVE</span>
      </div>

      <a class="scroll-cue" href="#statement" aria-label="Scroll to the next section">
        <span>Scroll</span>
        <span class="scroll-cue__line"><span></span></span>
      </a>
    </section>

    <section class="brand-statement" id="statement">
      <div class="brand-statement__meta" data-reveal>
        <span>00</span>
        <p>The idea comes first.<br />Everything else follows.</p>
      </div>
      <div class="brand-statement__body">
        <p class="eyebrow" data-reveal>Creative intent, made tangible</p>
        <h2 class="statement-title" data-statement>
          We bring space, story, and feeling into one carefully composed experience.
        </h2>
        <p data-reveal>
          From the first note to the final curtain, every detail is an invitation to feel part of something. Entertainment with energy, intention and a human connection.
        </p>
      </div>
    </section>

    <section class="home-services" aria-labelledby="services-title">
      <SectionHeading number="01" label="Selected Services" title="Disciplines in service of one clear idea." titleId="services-title" />
      <div class="home-services__layout">
        <div class="service-rows" data-service-list>
          {services.map((service, index) => (
            <a class="service-row" href={withBase('/services/')} data-service-row data-index={index}>
              <span class="service-row__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="service-row__title">{service.title}</span>
              <span class="service-row__description">Entertainment & production</span>
              <svg viewBox="0 0 32 16" aria-hidden="true"><path d="M1 8h27M21 1l7 7-7 7" /></svg>
            </a>
          ))}
        </div>
        <figure class="services-preview" data-service-preview data-reveal>
          <div class="services-preview__frame">
            <img src={media.material} alt="Sculptural fabric and warm light" width="1000" height="1500" loading="lazy" decoding="async" />
          </div>
          <figcaption>Material, light, atmosphere.</figcaption>
        </figure>
      </div>
    </section>

    <section class="show-section" aria-label="Next show"><ShowFeature show={nextShow} /></section>

    <section class="visual-story" aria-label="Creative approach">
      <div class="visual-story__media" data-story-media>
        <img src={media.hero} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
      </div>
      <p class="visual-story__vertical" aria-hidden="true">AUSTRALIS LIVE · Creative Services</p>
      <div class="visual-story__copy" data-reveal>
        <p class="eyebrow">Built from the atmosphere up</p>
        <h2>More than a setting. A world with its own pulse.</h2>
        <p>Every visual decision should move the same story forward—from the first impression to the final detail.</p>
      </div>
    </section>

    <section class="show-section" aria-label="Previous show"><ShowFeature show={previousShow} past /></section>

    <section class="about-teaser" aria-labelledby="about-title">
      <div class="about-teaser__media about-teaser__brand">
        <img src={withBase(siteConfig.logoPath)} alt={siteConfig.brandDisplayName} width="1254" height="1254" loading="lazy" decoding="async" />
      </div>
      <div class="about-teaser__copy" data-reveal>
        <p class="eyebrow">Behind every moment</p>
        <h2 id="about-title">Passionate minds.<br /><em>Purposeful creation.</em></h2>
        <p>
          For the artists. For the audience. For the moments that stay with us long after the lights go down.
        </p>
        <ArrowLink href="/about/" label="Discover the approach" variant="text" />
      </div>
    </section>

    <section class="final-cta" aria-labelledby="cta-title">
      <p class="eyebrow" data-reveal>Your next live experience</p>
      <h2 id="cta-title" data-reveal>Be there for<br /><em>the next moment.</em></h2>
      <div data-reveal><ArrowLink href="/events/" label="Find your show" variant="outline" /></div>
      <span class="final-cta__orb" aria-hidden="true"></span>
    </section>
  </div>

  <script>
    import { initHomeExperience } from '../scripts/animations/home';
    initHomeExperience();
  </script>
</BaseLayout>
