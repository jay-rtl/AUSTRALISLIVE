---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ArrowLink from '../components/ArrowLink.astro';
import OurTeam from '../components/OurTeam.astro';
import { withBase } from '../utils/paths';
import '../styles/shows.css';
---
<BaseLayout title="About & Our Team | Australis Live" description="Meet Arvin and Marc: the friendship, production experience and creative partnership behind AUSTRALIS LIVE.">
  <div class="about-intro">
    <PageHero variant="about" eyebrow="AUSTRALIS LIVE" title="For the artists. For the audience." intro="Entertainment and Management - bringing creative ambition and live experiences together.">
      <div class="about-intro__portraits" aria-hidden="true">
        <img src={withBase('/images/team/portrait-02-640.webp')} width="1448" height="1086" alt="" decoding="async" />
        <img src={withBase('/images/team/portrait-01-640.webp')} width="1448" height="1086" alt="" decoding="async" />
      </div>
    </PageHero>
  </div>
  <nav class="show-page team-jump" aria-label="About this page"><a href="#our-team">Meet our team ↓</a></nav>
  <section class="show-page editorial-copy">
    <p class="eyebrow">Our approach</p><h2>Make it mean something.</h2>
    <p>A song that takes you back. A room filled with laughter. A moment shared with the people beside you. These are the experiences at the heart of AUSTRALIS LIVE.</p>
    <p>Our focus is the connection between the stage and the audience, with care for the creative idea and the details that bring it to life.</p>
    <ArrowLink href="/events/" label="Explore the shows" />
  </section>
  <OurTeam />
</BaseLayout>

<style>
  @media (max-width: 899px) {
    .about-intro :global(.page-hero) {
      min-height: 0;
      padding-top: calc(8.5rem + env(safe-area-inset-top, 0px));
      padding-bottom: 1rem;
    }
    .about-intro :global(h1) { margin-bottom: 1.5rem; }
    .about-intro :global(.page-intro) { margin-bottom: 0; }
    .team-jump { margin-block: 0 3.5rem; padding-bottom: 0; }
  }
</style>
