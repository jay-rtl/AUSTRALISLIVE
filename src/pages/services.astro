---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Services | AUSTRALIS LIVE"
  description="Creative production, events, branding and visual experiences from AUSTRALIS LIVE."
>
  <PageHero
    eyebrow="Our expertise"
    title="Creative disciplines, deliberately shaped."
    intro="Creative thinking and considered execution, from the first idea to the live experience."
  />
  <section class="content-shell" aria-labelledby="services-list-title">
    <h2 class="sr-only" id="services-list-title">Services</h2>
    <ul class="service-list">
      {services.map((service) => (
        <li>
          <h2>{service.title}</h2>
          <p>{service.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
