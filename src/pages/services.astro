---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { services } from '../data/services';
import { withBase } from '../utils/paths';
import ServiceIcon from '../components/ServiceIcon.astro';
---

<BaseLayout
  title="Services | AUSTRALIS LIVE"
  description="Creative production, events, branding and visual experiences from AUSTRALIS LIVE."
>
  <PageHero
    variant="services"
    eyebrow="Our expertise"
    title="Creative disciplines, deliberately shaped."
    intro="Creative thinking and considered execution, from the first idea to the live experience."
  >
    <figure class="services-intro__image"><img src={withBase('/images/atmosphere/material-study.webp')} width="1000" height="1500" alt="Sculptural fabric and warm light" decoding="async" /></figure>
  </PageHero>
  <section class="content-shell" aria-labelledby="services-list-title">
    <h2 class="sr-only" id="services-list-title">Services</h2>
    <ul class="service-list">
      {services.map((service, index) => (
        <li>
          <h2><ServiceIcon index={index} />{service.title}</h2>
          <p>{service.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
