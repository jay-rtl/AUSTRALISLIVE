---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import headingFont from '../assets/fonts/manrope-latin.woff2?url';
import bodyFont from '../assets/fonts/instrument-sans-latin.woff2?url';
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/editorial.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase(siteConfig.logoPath)} type="image/png" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <SEOHead title={title} description={description} image={image} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      if (document.querySelector('.show-feature__art, .service-list li')) {
        import('../scripts/animations/editorial').then(({ initEditorialMotion }) => initEditorialMotion());
      }
    </script>
  </body>
</html>
